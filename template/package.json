{
  "name": "project-template",
  "version": "0.2.0",
  "private": true,
  "description": "Базовая инфраструктура для human+agent разработки: Backlog.md, GitNexus, коммитимый векторный RAG для документации, MCP-серверы окружения, git-хуки и валидаторы документации",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "prepare": "node scripts/git-hooks/install.mjs --quiet && node scripts/task-merge-driver.mjs install --quiet",
    "install-hooks": "node scripts/git-hooks/install.mjs",
    "test": "node --test scripts/**/*.test.mjs",
    "lint:docs": "node scripts/validate-docs.mjs && node scripts/rag/check-index.mjs",
    "policy:check": "node scripts/policy-check.mjs",
    "check-index": "node scripts/rag/check-index.mjs",
    "index-docs": "node scripts/rag/index-docs.mjs",
    "merge:generated": "node scripts/generated-merge.mjs resolve",
    "rag-server": "node scripts/rag/rag-server.mjs",
    "rag-search": "node scripts/rag/search-cli.mjs",
    "env-server": "node scripts/env/env-server.mjs",
    "sync-rules": "node scripts/sync-agent-rules.mjs",
    "bootstrap": "node scripts/bootstrap/bootstrap.mjs",
    "lightrag-setup": "node scripts/lightrag/setup.mjs",
    "lightrag-index": "node scripts/lightrag/run.mjs index_docs.py",
    "lightrag-query": "node scripts/lightrag/run.mjs query.py",
    "lightrag-server": "node scripts/lightrag/lightrag-server.mjs",
    "web": "node scripts/web.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^3.5.0",
    "@lancedb/lancedb": "^0.31.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "gray-matter": "^4.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "backlog.md": "^1.50.1"
  }
}
