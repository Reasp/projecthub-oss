#!/bin/sh
# Git commit-msg hook: чистота git-истории (правило 13 infra-dev.md).
#
# Отклоняет сообщения коммитов со строками атрибуции AI-ассистентов: `Co-Authored-By: Claude …`,
# `Generated with Claude Code`, `Generated by AI`, `Assisted by …`, эмодзи-подписи агентов.
# Все коммиты оформляются от имени автора репозитория. Проверяются только AI-маркеры —
# обычные Co-Authored-By с людьми проходят.
#
# $1 — файл с сообщением коммита. Обход — только по явной просьбе пользователя
# (`git commit --no-verify`) или INFRA_HOOKS_SKIP=1.

if [ "$INFRA_HOOKS_SKIP" = "1" ]; then
  exit 0
fi

MSG_FILE="$1"
if [ ! -f "$MSG_FILE" ]; then
  exit 0
fi

# Комментарии (# …) git сам вырежет — их не проверяем.
BODY=$(grep -v '^#' "$MSG_FILE")

AI_NAMES='claude|anthropic|chatgpt|openai|gpt-?[0-9]|copilot|gemini|antigravity|codex|cursor|windsurf|cline|roo code|aider|devin|noreply@anthropic\.com'

FOUND=""

# 1. Трейлеры соавторства/атрибуции с AI-именем.
MATCH=$(printf '%s\n' "$BODY" | grep -iE "^[[:space:]]*(co-authored-by|assisted-by|generated-by|authored-by|signed-off-by)[[:space:]]*:.*($AI_NAMES)")
[ -n "$MATCH" ] && FOUND="$FOUND
$MATCH"

# 2. Фразы вида «Generated with Claude Code», «Generated by AI», «Made with Copilot», «Assisted by Gemini».
MATCH=$(printf '%s\n' "$BODY" | grep -iE "(generated|made|created|written|assisted|co-?authored)[[:space:]]+(with|by)[[:space:]]+(\[?)($AI_NAMES|an? ?ai\b|ai\b)")
[ -n "$MATCH" ] && FOUND="$FOUND
$MATCH"

# 3. Русские варианты: «сгенерировано Claude», «при помощи ИИ», «с помощью Copilot».
MATCH=$(printf '%s\n' "$BODY" | grep -iE "(сгенерировано|создано|написано|при помощи|с помощью|при участии)[[:space:]]+(\[?)($AI_NAMES|ии\b|ai\b|нейросет)")
[ -n "$MATCH" ] && FOUND="$FOUND
$MATCH"

# 4. Эмодзи-подпись агентов.
MATCH=$(printf '%s\n' "$BODY" | grep -E "🤖")
[ -n "$MATCH" ] && FOUND="$FOUND
$MATCH"

if [ -n "$FOUND" ]; then
  echo "[commit-msg] Коммит отклонён: в сообщении есть атрибуция AI-ассистента (правило 13 infra-dev.md):"
  printf '%s\n' "$FOUND" | sed '/^$/d; s/^/    > /'
  echo "[commit-msg] Уберите эти строки — коммиты оформляются от имени автора репозитория."
  exit 1
fi

exit 0
