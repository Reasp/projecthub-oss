#!/bin/sh
# Git pre-commit hook: гейт качества документации (правила 1, 14, 20 infra-dev.md).
#
# Гоняет `lint:docs`: validate-docs.mjs (frontmatter, даты в кавычках, картинки, таблицы, разделы и ссылки [[id]]) и
# rag/check-index.mjs (актуальность .rag-index относительно backlog/docs, backlog/decisions).
# Проверки дешёвые (хэши и парсинг markdown, без эмбеддингов), поэтому выполняются на каждый
# коммит, а не только при изменении backlog/. Обход — только по явной просьбе пользователя
# (`git commit --no-verify`) или INFRA_HOOKS_SKIP=1.
#
# Путь к инфраструктуре вычисляется от самого хука: он лежит в <infra>/scripts/git-hooks/,
# а cwd у git-хуков — корень репозитория, который может быть на уровень выше (режим подпапки).

if [ "$INFRA_HOOKS_SKIP" = "1" ]; then
  exit 0
fi

HOOK_DIR=$(cd "$(dirname "$0")" && pwd)
INFRA_ROOT=$(cd "$HOOK_DIR/../.." && pwd)

NODE_BIN=""
if command -v node >/dev/null 2>&1; then
  NODE_BIN="node"
elif [ -f "/c/Program Files/nodejs/node.exe" ]; then
  NODE_BIN="/c/Program Files/nodejs/node.exe"
elif [ -f "C:/Program Files/nodejs/node.exe" ]; then
  NODE_BIN="C:/Program Files/nodejs/node.exe"
fi

if [ -z "$NODE_BIN" ]; then
  echo "[pre-commit] node не найден — проверка документации пропущена."
  exit 0
fi

if [ ! -f "$INFRA_ROOT/scripts/validate-docs.mjs" ]; then
  echo "[pre-commit] scripts/validate-docs.mjs не найден рядом с хуком — проверка пропущена."
  exit 0
fi

echo "[pre-commit] Валидация документации Backlog.md..."
if ! "$NODE_BIN" "$INFRA_ROOT/scripts/validate-docs.mjs"; then
  echo "[pre-commit] Коммит остановлен: исправьте формат документации (npm run lint:docs)."
  exit 1
fi

if [ -f "$INFRA_ROOT/scripts/rag/check-index.mjs" ]; then
  echo "[pre-commit] Проверка актуальности RAG-индекса..."
  if ! "$NODE_BIN" "$INFRA_ROOT/scripts/rag/check-index.mjs"; then
    echo "[pre-commit] Коммит остановлен: пересоберите индекс (npm run index-docs) и добавьте .rag-index/ в коммит."
    exit 1
  fi
fi

exit 0
