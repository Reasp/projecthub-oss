{
  "name": "project-hub",
  "version": "0.1.49",
  "private": true,
  "description": "ProjectHub — Единая десктопная панель управления проектами с обвязкой ProjectTemplate (Backlog.md, Git, RAG, MCP, Dev-окружение)",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/version.mjs install-hooks && node scripts/task-merge-driver.mjs install --quiet && node scripts/site/configure-submodule.mjs --quiet",
    "site:export": "node scripts/site/export-product-context.mjs",
    "dev": "vite",
    "lint:docs": "node scripts/validate-docs.mjs && node scripts/rag/check-index.mjs",
    "check-index": "node scripts/rag/check-index.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "vitest run --project unit",
    "test:process": "vitest run --project process",
    "cpu-load": "node scripts/cpu-load.mjs",
    "backlog:merge": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/backlog-merge.mjs",
    "build": "node scripts/build-info.mjs && node scripts/version.mjs check && node scripts/validate-docs.mjs && node scripts/rag/check-index.mjs --warn && npm run lint && npm run test && tsc && vite build && npm run build:mobile && npm run build:ph-agent && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "build:mobile": "vite build --config mobile/vite.config.ts",
    "build:mobile:capacitor": "vite build --config mobile/vite.config.ts --mode capacitor",
    "build:ph-agent": "vite build --config vite.ph-agent.config.ts",
    "build:open": "node scripts/build-open-edition.mjs",
    "dev:mobile": "vite --config mobile/vite.config.ts",
    "mobile:android:apk": "node scripts/mobile/android.mjs build",
    "mobile:android:install": "node scripts/mobile/android.mjs install",
    "mobile:ios:sim": "node scripts/mobile/ios.mjs sim",
    "mobile:ios:selftest": "node scripts/mobile/ios.mjs selftest",
    "mobile:ios:install": "node scripts/mobile/ios.mjs install",
    "mobile:ios:open": "node scripts/mobile/ios.mjs open",
    "pack:win": "node scripts/pack-win.mjs",
    "selfcheck:ui": "node scripts/visual/selfcheck.mjs",
    "voice-bench:record": "node scripts/voice-bench/record-server.mjs",
    "pack:mac": "node scripts/pack-mac.mjs",
    "install:mac": "node scripts/pack-mac.mjs --install",
    "dist:win": "npm run build && electron-builder --win portable && node scripts/patch-exe-icon.mjs",
    "dist:mac": "node scripts/pack-mac.mjs --dist",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist": "npm run build && electron-builder --win && node scripts/patch-exe-icon.mjs",
    "setup": "node scripts/setup.mjs",
    "index-docs": "node scripts/rag/index-docs.mjs",
    "rag-server": "node scripts/rag/rag-server.mjs",
    "rag-search": "node scripts/rag/search-cli.mjs",
    "env-server": "node scripts/env/env-server.mjs",
    "sync-rules": "node scripts/sync-agent-rules.mjs",
    "bootstrap": "node scripts/bootstrap/bootstrap.mjs",
    "lightrag-setup": "node scripts/lightrag/setup.mjs",
    "lightrag-index": "node scripts/lightrag/run.mjs index_docs.py",
    "lightrag-query": "node scripts/lightrag/run.mjs query.py",
    "lightrag-server": "node scripts/lightrag/lightrag-server.mjs",
    "qwen-tts-setup": "node electron/workers/qwen/setup.mjs",
    "web": "node scripts/web.mjs",
    "remote-relay": "node scripts/remote-relay-server.mjs",
    "federation-smoke": "node scripts/federation-smoke.mjs",
    "telegram-bot": "node scripts/telegram-bot.mjs",
    "lint": "eslint . && node scripts/lint-main-errors.mjs",
    "lint:fix": "eslint . --fix",
    "check-bundle": "node scripts/check-bundle.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:bump": "node scripts/version.mjs bump"
  },
  "build": {
    "appId": "com.projecthub.desktop",
    "productName": "ProjectHub",
    "icon": "build/icon.ico",
    "afterPack": "./scripts/mac/after-pack.mjs",
    "protocols": [
      {
        "name": "ProjectHub",
        "schemes": [
          "projecthub"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "template",
        "to": "template",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/build-info.json",
        "to": "build-info.json"
      },
      {
        "from": "resources/voice-models",
        "to": "voice-models",
        "filter": [
          "*.onnx"
        ]
      }
    ],
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "Reasp",
      "repo": "projecthub-oss",
      "releaseType": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-",
      "sign": "./scripts/mac/sign.mjs",
      "timestamp": "none",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ProjectHub использует микрофон для голосового управления и ассистента.",
        "NSLocalNetworkUsageDescription": "ProjectHub подключается к другим вашим компьютерам и телефону в локальной сети."
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/@lancedb/**",
      "**/apache-arrow/**",
      "**/node-pty/**",
      "**/uiohook-napi/**",
      "**/node-gyp-build/**",
      "**/sherpa-onnx-node/**",
      "**/sherpa-onnx-win-x64/**",
      "**/sherpa-onnx-win-ia32/**",
      "**/sherpa-onnx-linux-x64/**",
      "**/sherpa-onnx-linux-arm64/**",
      "**/sherpa-onnx-darwin-x64/**",
      "**/sherpa-onnx-darwin-arm64/**"
    ],
    "portable": {
      "useZip": true
    }
  },
  "author": "ProjectHub Team",
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^3.5.0",
    "@lancedb/lancedb": "^0.31.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/qrcode": "^1.5.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "apache-arrow": "^18.1.0",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "electron-updater": "^6.8.9",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.13",
    "mermaid": "^11.17.2",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sherpa-onnx-node": "^1.13.8",
    "sigma": "3.0.3",
    "simple-git": "^3.36.0",
    "tailwind-merge": "^3.6.0",
    "tree-kill": "^1.2.2",
    "uiohook-napi": "^1.5.5",
    "unbzip2-stream": "^1.4.3",
    "ws": "^8.21.3",
    "zod": "^3.24.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/unbzip2-stream": "^1.4.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "graphology-types": "0.24.8",
    "jsqr": "1.4.0",
    "playwright-core": "1.63.0",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.0"
  }
}
